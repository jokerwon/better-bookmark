{
  "name": "better-bookmark",
  "displayName": "智能书签分类",
  "version": "0.1.0",
  "private": true,
  "description": "AI 书签智能分类浏览器扩展",
  "scripts": {
    "dev": "npm run build:manifest && vite build --watch",
    "build": "npm run clean && npm run build:manifest && vite build && npm run build:background",
    "build:manifest": "esno scripts/manifest.ts",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run --config vite.config.mts",
    "lint": "eslint --cache .",
    "build:background": "vite build --config vite.config.background.mts",
    "clean": "rimraf --glob extension/dist extension/manifest.json"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^2.27.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.5.0",
    "@types/webextension-polyfill": "^0.12.0",
    "@typescript-eslint/eslint-plugin": "^8.2.0",
    "@unocss/reset": "^0.62.2",
    "@vitejs/plugin-vue": "^5.1.2",
    "@vue/test-utils": "^2.4.6",
    "@vueuse/core": "^11.0.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.9.0",
    "esno": "^4.7.0",
    "fs-extra": "^11.2.0",
    "jsdom": "^24.1.1",
    "kolorist": "^1.8.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.5.4",
    "unocss": "^0.62.2",
    "vite": "^5.4.2",
    "vitest": "^2.0.5",
    "vue": "^3.4.38",
    "vue-demi": "^0.14.10",
    "vue-tsc": "^2.1.10",
    "webextension-polyfill": "^0.12.0"
  }
}
